<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@drawable/ic_launcher_background"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.MiAplicación">
        <activity
            android:name=".ButtonActivity1"
            android:exported="true">

        </activity>
        <activity
            android:name=".ButtonActivity2"
            android:exported="true">

        </activity>
        <activity
            android:name=".ButtonActivity"
            android:exported="true">

        </activity>
        <activity android:name=".MainActivity"
            android:exported="true"
            tools:ignore="Instantiatable">



        </activity>
        <activity android:name="EditTextActivity"
            android:exported="true">

        </activity>
        <activity android:name=".CalculadoraActivity"
            android:exported="true">

        </activity>
        <activity android:name=".PaisActivity"
            android:exported="true">

        </activity>
        <activity android:name=".Pais2Activity"
            android:exported="true">

        </activity>
        <activity android:name=".MenuActivity"
            android:exported="true">
        </activity>
        <activity android:name=".DialogoActivity"
            android:exported="true">

        </activity>
        <activity android:name=".CalendarioActivity"
            android:exported="true">

        </activity>
        <activity android:name=".NotificacionActivity"
            android:exported="true"
            android:parentActivityName=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <meta-data
                android:name="android.support.PARENT_ACTIVITY"
                android:value=".MainActivity"/>
        </activity>



    </application>
</manifest>


