<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp">

    <!-- Pantalla de la calculadora -->
    <TextView
        android:id="@+id/numeros"
        android:layout_width="match_parent"
        android:layout_height="150dp"
        android:textSize="32sp"
        android:text=""
        android:background="#E0E0E0"/>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="8dp">

        <Button
            android:id="@+id/btnActualizar"
            android:layout_width="0dp"
            android:layout_height="100dp"
            android:layout_weight="3"
            android:text="C"
            android:textSize="20sp"
            android:backgroundTint="#EE0E0E"/>
        <Button
            android:id="@+id/btnDivision"
            android:layout_width="0dp"
            android:layout_height="100dp"
            android:layout_weight="1"
            android:text="/"
            android:textSize="20sp"
            android:backgroundTint="#EE0E0E"/>
    </LinearLayout>

    <!-- Fila de botones 1 (Ejemplo: 7, 8, 9, Suma) -->

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="8dp">

        <Button
            android:id="@+id/btn7"
            android:layout_width="0dp"
            android:layout_height="100dp"
            android:layout_weight="1"
            android:text="7"
            android:textSize="20sp"
            android:textColor="@color/black"
            android:backgroundTint="@color/white" />

        <Button
            android:id="@+id/btn8"
            android:layout_width="0dp"
            android:layout_height="100dp"
            android:layout_weight="1"
            android:text="8"
            android:textSize="20sp"
            android:textColor="@color/black"
            android:backgroundTint="@color/white"/>

        <Button
            android:id="@+id/btn9"
            android:layout_width="0dp"
            android:layout_height="100dp"
            android:layout_weight="1"
            android:text="9"
            android:textSize="20sp"
            android:textColor="@color/black"
            android:backgroundTint="@color/white"/>

        <Button
            android:id="@+id/btnSuma"
            android:layout_width="0dp"
            android:layout_height="100dp"
            android:layout_weight="1"
            android:text="+"
            android:textSize="20sp"
            android:backgroundTint="#EE0E0E"/>
    </LinearLayout>

    <!-- Puedes seguir añadiendo más filas de LinearLayout horizontal para el resto de números y botones -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="8dp">

        <Button
            android:id="@+id/btn4"
            android:layout_width="0dp"
            android:layout_height="100dp"
            android:layout_weight="1"
            android:text="4"
            android:textSize="20sp"
            android:textColor="@color/black"
            android:backgroundTint="@color/white"/>

        <Button
            android:id="@+id/btn5"
            android:layout_width="0dp"
            android:layout_height="100dp"
            android:layout_weight="1"
            android:text="5"
            android:textSize="20sp"
            android:textColor="@color/black"
            android:backgroundTint="@color/white"/>

        <Button
            android:id="@+id/btn6"
            android:layout_width="0dp"
            android:layout_height="100dp"
            android:layout_weight="1"
            android:text="6"
            android:textSize="20sp"
            android:textColor="@color/black"
            android:backgroundTint="@color/white"/>

        <Button
            android:id="@+id/btnResta"
            android:layout_width="0dp"
            android:layout_height="100dp"
            android:layout_weight="1"
            android:text="-"
            android:textSize="20sp"
            android:backgroundTint="#EE0E0E"/>
    </LinearLayout>
<!-- botones 123-->
 <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="8dp">

        <Button
            android:id="@+id/btn1"
            android:layout_width="0dp"
            android:layout_height="100dp"
            android:layout_weight="1"
            android:text="1"
            android:textSize="20sp"
            android:textColor="@color/black"
            android:backgroundTint="@color/white"/>

        <Button
            android:id="@+id/btn2"
            android:layout_width="0dp"
            android:layout_height="100dp"
            android:layout_weight="1"
            android:text="2"
            android:textSize="20sp"
            android:textColor="@color/black"
            android:backgroundTint="@color/white"/>

        <Button
            android:id="@+id/btn3"
            android:layout_width="0dp"
            android:layout_height="100dp"
            android:layout_weight="1"
            android:text="3"
            android:textSize="20sp"
            android:textColor="@color/black"
            android:backgroundTint="#FFFFFF"/>

        <Button
            android:id="@+id/btnMultiplicacion"
            android:layout_width="0dp"
            android:layout_height="100dp"
            android:layout_weight="1"
            android:text="x"
            android:textSize="20sp"
            android:backgroundTint="#EE0E0E"/>
    </LinearLayout>
    <!--Ultima fil-->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="8dp">

        <Button
            android:id="@+id/btnx"
            android:layout_width="0dp"
            android:layout_height="100dp"
            android:layout_weight="1"
            android:text="x"
            android:textSize="20sp"
            android:backgroundTint="#EE0E0E"/>

        <Button
            android:id="@+id/btnPunto"
            android:layout_width="0dp"
            android:layout_height="100dp"
            android:layout_weight="1"
            android:text="."
            android:textSize="20sp"
            android:backgroundTint="#EE0E0E"/>

        <Button
            android:id="@+id/btn0"
            android:layout_width="0dp"
            android:layout_height="100dp"
            android:layout_weight="1"
            android:text="0"
            android:textSize="20sp"
            android:backgroundTint="#EE0E0E"/>

        <Button
            android:id="@+id/btnResultado"
            android:layout_width="0dp"
            android:layout_height="100dp"
            android:layout_weight="1"
            android:text="="
            android:textSize="20sp"
            android:backgroundTint="#EE0E0E"/>
    </LinearLayout>

</LinearLayout>